# Copiar a .env (mismo directorio que docker-compose.yml). Nunca commitear el .env real.

# Firma de los access tokens del login. Generar uno propio POR ENTORNO:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiar-esto-en-cada-entorno

# Marca con la que se emiten los documentos: EASY OFFICE o INOFFICE.
# MARCA_POR_DEFECTO=EASY OFFICE

# Datos de pago del contrato, uno por marca. Deben leerse despues de la frase
# "...a la cuenta corriente N° " del contrato. Ejemplo (inventado):
# BANCO_TEXTO_EASY_OFFICE=12345678 del Banco Estado, a nombre de su titular EASY OFFICE SpA, R.U.T. 76.767.272-1
# BANCO_TEXTO_INOFFICE=

# Conexion con la API de firma. En desarrollo no hace falta definirlas: los
# valores por defecto del docker-compose coinciden con los de la API de firma.
# En un entorno real, usar claves propias y que sean las mismas en ambos lados
# (FIRMA_API_KEY debe estar en API_KEYS de la API; FIRMA_WEBHOOK_SECRET igual a su WEBHOOK_SECRET).
# FIRMA_API_URL=http://firma-api:8000/api/v1
# FIRMA_API_KEY=
# FIRMA_WEBHOOK_SECRET=
# FIRMA_CALLBACK_URL=http://backend:8000/api/webhooks/firma