# Copiar a .env (mismo directorio que docker-compose.yml). Nunca commitear el .env real.
# En desarrollo todos tienen un valor por defecto; en producción (APP_ENV=production)
# la API no arranca si algún secreto sigue con el valor "dev-inseguro-cambiar".

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_PASSWORD=firma

S3_ACCESS_KEY=firma-minio
S3_SECRET_KEY=dev-inseguro-cambiar

# 32 bytes en hex (64 caracteres). El valor de abajo es SOLO para desarrollo (es público);
# en producción la API lo rechaza. Generar uno propio: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY_HEX=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_PEPPER=dev-inseguro-cambiar

# Parámetros legales — VALIDAR CON ABOGADO
RETENTION_YEARS=6
DOCUMENT_DEFAULT_EXPIRATION_DAYS=30

# Solo en producción detrás de Nginx: IP del proxy confiable (separadas por coma).
FORWARDED_ALLOW_IPS=127.0.0.1

# API keys aceptadas (separadas por coma). El CRM envía una en el header X-API-Key.
# Generar: python -c "import secrets; print('fk_test_' + secrets.token_urlsafe(24))"
API_KEYS=fk_test_dev-inseguro-cambiar
# Secreto para firmar los webhooks (HMAC-SHA256). El CRM usa el mismo valor para verificarlos.
WEBHOOK_SECRET=dev-inseguro-cambiar
# Hosts a los que la API puede enviar webhooks (evita SSRF).
WEBHOOK_ALLOWED_HOSTS=backend,localhost,127.0.0.1,host.docker.internal
# Dirección pública de la API (se imprime en la hoja de evidencias).
PUBLIC_BASE_URL=http://localhost:8100
# Quién firma automáticamente — VALIDAR CON ABOGADO
ORGANIZATION_SIGNER_NAME=Easy Office SpA
