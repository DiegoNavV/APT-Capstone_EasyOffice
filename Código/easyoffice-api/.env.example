# Copiar a .env y ajustar. Nunca commitear el .env real.

DATABASE_URL=postgresql+psycopg://easyoffice:easyoffice@localhost:5432/crm_easyoffice

# Generar uno propio POR ENTORNO (nunca reutilizar el mismo secreto en dev/prod):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiar-esto-en-cada-entorno
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=90
REFRESH_TOKEN_EXPIRE_DAYS=7

# Umbral de bloqueo de cuenta por intentos fallidos (fuerza bruta).
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# Orígenes del frontend permitidos para CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# true SOLO si la API corre detrás de HTTPS real (el proxy inverso en
# producción). En localhost sin HTTPS debe quedar en false, o el navegador
# descarta la cookie de refresh token.
COOKIE_SECURE=false
